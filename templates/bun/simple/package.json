{
  "name": "{{ .Slug }}",
  "version": "0.1.0",
  "description": "{{ .Name }}, a command handler on nullplatform",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "describe": "bun src/index.ts --describe",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "build": "bun build --compile src/index.ts --outfile dist/{{ .Slug }}"
  },
  "dependencies": {
    "@nullplatform/plugin": "^0.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
