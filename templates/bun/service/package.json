{
  "name": "{{ .Slug }}",
  "version": "0.1.0",
  "description": "{{ .Name }}, an application dependency on nullplatform",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "describe": "bun src/main.ts --describe",
    "test": "bun test",
    "build": "bun build --compile src/main.ts --outfile dist/{{ .Slug }}",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@nullplatform/plugin": "0.1.11"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
